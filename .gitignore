# Data — keep the repo light; raw/large files stay local
data/raw/
data/interim/
data/external/
# Immutable publication freezes: the large raw sources stay local, but the small
# derived tables the article is built and validated from ARE committed — without
# them src/build_page.py and src/check_article.py cannot run on a clean checkout.
data/publication_freezes/*/sources/
*.parquet
*.csv
!data/processed/.gitkeep
# hand-curated Stage-2 dataset — authored content, not a reproducible artifact
!data/stage2/*.csv
# tiny committed audit artifact — upstream git history could vanish
!data/processed/confidencial_panel.csv
# publication inputs — the article's build and validation gate depend on these
!data/publication_freezes/*/derived/*.csv

# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.python-version

# OS / editor / sync conflicts
.DS_Store
.vscode/
.idea/
* (1).*
*(1)*
*conflicted copy*
*.tmp
